# Port di host yang dibuka untuk dashboard (masukkan port ini ke Homeport)
GLASS_PORT=3070
# 0.0.0.0 = bisa diakses dari LAN/Tailscale; 127.0.0.1 = hanya dari mesin ini (lewat tunnel)
GLASS_BIND=0.0.0.0
# Kosongkan untuk data contoh. Data asli: taruh file di ./data lalu isi misalnya /data/aset_palu.geojson
GLASS_ASSETS_FILE=

# --- Drone AI (opsional) ---
# VLM untuk menjelaskan foto/video drone dengan kalimat. Kosongkan untuk mematikan.
# Ollama di Mac (di luar Docker):  brew install ollama && ollama pull qwen3-vl:2b
GLASS_VLM_PROVIDER=
# ollama -> http://host.docker.internal:11434 | openai -> https://api.openai.com/v1 | anthropic -> https://api.anthropic.com
GLASS_VLM_URL=
# kosong = bawaan (ollama: qwen3-vl:2b, anthropic: claude-haiku-5-5); openai wajib diisi
GLASS_VLM_MODEL=
GLASS_VLM_API_KEY=
# batas ukuran video yang diunggah (MB)
GLASS_MAX_UPLOAD_MB=300
