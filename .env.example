# Port di host yang dibuka untuk dashboard (masukkan port ini ke Homeport)
GLASS_PORT=3070
# 0.0.0.0 = bisa diakses dari LAN/Tailscale; 127.0.0.1 = hanya dari mesin ini (lewat tunnel)
GLASS_BIND=0.0.0.0
# Kosongkan untuk data contoh. Data asli: taruh file di ./data lalu isi misalnya /data/aset_palu.geojson
GLASS_ASSETS_FILE=
